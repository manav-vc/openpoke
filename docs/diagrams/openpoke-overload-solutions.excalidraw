      "fontSize": 19,
      "baseFontSize": null,
      "fontFamily": 5,
      "text": "End an EA run after 300 seconds. After a backend restart,\nresume queued jobs that have not expired.\nAllow 1 automatic retry of eligible interrupted read-only work per\ninitiating request.\nInterrupted writes or unknown tools require review.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "End an EA run after 300 seconds. After a backend restart, resume queued jobs that have not expired.\nAllow 1 automatic retry of eligible interrupted read-only work per initiating request.\nInterrupted writes or unknown tools require review.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
