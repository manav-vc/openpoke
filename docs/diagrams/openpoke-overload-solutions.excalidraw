      "fontSize": 23,
      "baseFontSize": null,
      "fontFamily": 5,
      "text": "1. Interaction Agent context: Loading the full EA roster bloats the Interaction Agent’s context window.\n2. Execution Agent history: Loading an EA’s entire execution history bloats that EA’s context window.\n3. Execution overload: Too many simultaneous EA runs can overload system resources.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Interaction Agent context: Loading the full EA roster bloats the Interaction Agent’s context window.\n2. Execution Agent history: Loading an EA’s entire execution history bloats that EA’s context window.\n3. Execution overload: Too many simultaneous EA runs can overload system resources.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
