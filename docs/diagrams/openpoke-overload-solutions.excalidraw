    {
      "id": "keogoV-5WT3qZASHNUi14",
      "type": "text",
      "x": 64,
      "y": 2261,
      "width": 660,
      "height": 175,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": {
        "type": 2
      },
      "roughness": 2,
      "opacity": 100,
      "angle": 0,
      "seed": 2043109055,
      "version": 37,
      "versionNonce": 10063365,
      "index": "bGA",
      "isDeleted": false,
      "groupIds": [
        "3sraj9BKETsOuyPFWI2wu"
      ],
      "frameId": null,
      "boundElements": [],
      "updated": 1794707571070,
      "created": 1794695682839,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "text": "Recorded offline results (November 14, 2026):\n129 automated tests passed.\nThe expected EA appeared in the top 30 candidates in all 60\nlabeled retrieval cases.\nNo identity-conflict or ambiguity-guard failures were recorded.\nThe candidate pool stayed at 30 with 1,000 and 10,000 saved\nEAs.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recorded offline results (November 14, 2026):\n129 automated tests passed.\nThe expected EA appeared in the top 30 candidates in all 60 labeled retrieval cases.\nNo identity-conflict or ambiguity-guard failures were recorded.\nThe candidate pool stayed at 30 with 1,000 and 10,000 saved EAs.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "l9wKeK1lJ6wE1uvxeMUB1",
      "type": "text",
      "x": 790,
      "y": 2228,
      "width": 660,
      "height": 18.75,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": {
        "type": 2
      },
      "roughness": 2,
      "opacity": 100,
      "angle": 0,
      "seed": 1678454495,
      "version": 37,
      "versionNonce": 437387467,
      "index": "bGB",
