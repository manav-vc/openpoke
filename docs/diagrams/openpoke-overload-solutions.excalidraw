      "versionNonce": 1624725453,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794695682842,
      "created": 1794695682841,
      "link": null,
      "locked": false,
      "text": "Offline embeddings and model/Gmail behavior are test doubles.\nCandidate recall does not prove the live model chooses\ncorrectly or that real Gmail tasks succeed.\nLive end-to-end testing is still needed.\nThis implementation supports one backend process.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Offline embeddings and model/Gmail behavior are test doubles.\nCandidate recall does not prove the live model chooses\ncorrectly or that real Gmail tasks succeed.\nLive end-to-end testing is still needed.\nThis implementation supports one backend process.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
