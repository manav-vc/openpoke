      "customData": {
        "slide": 7,
        "speakerNotes": "Archive only eligible completed EAs after 30 inactive days. Pending approval, active Triggers, work and interruptions prevent archival. Restart recovery preserves eligible queued work. Clear History is a reset, not restart recovery."
      }
    },
