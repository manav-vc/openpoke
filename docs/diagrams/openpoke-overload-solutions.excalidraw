    },
    {
      "id": "Ju46LQmZ4MaFGVNtVkK0R",
      "type": "text",
      "x": 790,
      "y": 2261,
      "width": 660,
      "height": 175,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": {
        "type": 2
      },
      "roughness": 2,
      "opacity": 100,
      "angle": 0,
      "seed": 1369438975,
      "version": 39,
      "versionNonce": 1218676069,
      "index": "bGC",
      "isDeleted": false,
      "groupIds": [
        "3sraj9BKETsOuyPFWI2wu"
      ],
      "frameId": null,
      "boundElements": [],
      "updated": 1794707571070,
      "created": 1794695682841,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "text": "Offline checks use stand-ins for embeddings, model responses, and\nGmail behavior.\nFinding the expected EA among the candidates does not prove the\nlive Interaction Agent selects it correctly or that real Gmail\noperations succeed.\nLive end-to-end testing is still needed.\nThis implementation supports one backend process.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Offline checks use stand-ins for embeddings, model responses, and Gmail behavior.\nFinding the expected EA among the candidates does not prove the live Interaction Agent selects it correctly or that real Gmail operations succeed.\nLive end-to-end testing is still needed.\nThis implementation supports one backend process.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KFs4hdN82HnUl0xBPzt2v",
      "type": "text",
      "x": 42,
      "y": 2614,
      "width": 2170,
      "height": 23.75,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
