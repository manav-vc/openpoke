      "baseFontSize": null,
      "fontFamily": 5,
      "text": "Reduce clutter in the active EA list.\nArchived EAs remain searchable; accepted continuation reopens\nthe same EA with its saved history.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reduce clutter in the active EA list.\nArchived EAs remain searchable; accepted continuation reopens the same EA with its saved history.",
