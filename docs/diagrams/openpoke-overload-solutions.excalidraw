      "baseFontSize": null,
      "fontFamily": 5,
      "text": "Save the EA jobs in each request's result group.\nDeliver the group to the Interaction Agent once submissions are\nfinished and every job has an outcome:\nsucceeded, failed, rejected, expired, or interrupted.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Save the EA jobs in each request's result group.\nDeliver the group to the Interaction Agent once submissions are finished and every job has an outcome:\nsucceeded, failed, rejected, expired, or interrupted.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
