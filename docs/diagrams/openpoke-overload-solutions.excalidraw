      "locked": false,
      "fontSize": 19,
      "baseFontSize": null,
      "fontFamily": 5,
      "text": "Saved EAs accumulate after their work is complete.\nAn inactive EA may still have unfinished work.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Saved EAs accumulate after their work is complete.\nAn inactive EA may still have unfinished work.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
