    {
      "id": "LBVp9G24vLZ9mi-tJnvXo",
      "type": "frame",
      "x": 4926,
      "y": 2988,
      "width": 1280,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHo",
      "roundness": null,
      "seed": 663594087,
      "version": 3,
      "versionNonce": 1592295272,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794794897700,
      "created": 1794794897700,
      "link": null,
      "locked": false,
      "customData": {
        "slidesOrder": 3,
        "mcpSlideLayout": "steps",
        "mcpSlideDesign": {
          "style": "excalidraw",
          "accent": "violet",
          "decor": true
        },
        "presenterNotes": "- Keyword search helps with exact terms. Semantic search helps when the user expresses the same intent in different words.\n- Both searches contribute bounded results. Reciprocal rank fusion merges their rankings with k=60.\n- A shared person is insufficient evidence. INV-1042 and INV-1043 from the same sender represent separate work.\n- The model inspects the current record and submits its version, which helps reject stale routing.\n- Reusing a stable EA ID keeps its execution history together. Archived EAs can reopen on accepted continuation."
      },
      "name": "04 — Find, verify, reuse"
    },
    {
      "id": "G9vVqzv9Y19CupssPSqZb",
      "type": "frame",
      "x": 6556,
      "y": 2988,
      "width": 1280,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIO",
      "roundness": null,
      "seed": 507391719,
      "version": 2,
      "versionNonce": 254662409,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794794897766,
      "created": 1794794897766,
      "link": null,
      "locked": false,
      "customData": {
        "slidesOrder": 4,
        "mcpSlideLayout": "columns",
        "mcpSlideDesign": {
          "style": "excalidraw",
          "accent": "violet",
          "decor": true
        },
        "presenterNotes": "- The IA conversation and each EA execution history have separate budgets.\n- A summary helps with continuity, but it can omit an exact amount, recipient, or instruction. Source retrieval provides the original detail.\n- The default history budget is 8,000 estimated tokens for each agent context. That is a history budget, not a guarantee about the entire model prompt.\n- New source records remain available after compaction. Previously truncated legacy results cannot be reconstructed.\n- Source: server/services/execution/history.py, docs/agent-optimization.md, and .env.example."
      },
      "name": "05 — Bounded context"
    },
