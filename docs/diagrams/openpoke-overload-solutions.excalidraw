      "link": null,
      "locked": false,
      "fontSize": 19,
      "baseFontSize": null,
      "fontFamily": 5,
      "text": "Shown limits are configurable defaults. This board explains the design decisions for finding EAs, loading each agent's context, and controlling EA runs.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Shown limits are configurable defaults. This board explains the design decisions for finding EAs, loading each agent's context, and controlling EA runs.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
