      "baseFontSize": null,
      "fontFamily": 5,
      "text": "The Interaction Agent handles related EA outcomes together.\nEach initiating user request allows at most 5 follow-up stages\nand 20 EA job submissions.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Interaction Agent handles related EA outcomes together.\nEach initiating user request allows at most 5 follow-up stages and 20 EA job submissions.",
