      "link": null,
      "locked": false,
      "fontSize": 19,
      "baseFontSize": null,
      "fontFamily": 5,
      "text": "Archive an EA after its work is explicitly complete and it has\nbeen inactive for 30 days.\nPending work or approvals, active Triggers, queued or running\njobs, ambiguous legacy history, or unresolved interruptions\nprevent automatic archival.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Archive an EA after its work is explicitly complete and it has been inactive for 30 days.\nPending work or approvals, active Triggers, queued or running jobs, ambiguous legacy history, or unresolved interruptions prevent automatic archival.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
