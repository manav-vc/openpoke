    {
      "id": "njFDT3kFeCilvKrDqRiE4",
      "type": "text",
      "x": 1586,
      "y": 2279.5,
      "width": 608,
      "height": 118.75,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": {
        "type": 2
      },
      "roughness": 2,
      "opacity": 100,
      "angle": 0,
      "seed": 1132346847,
      "version": 39,
      "versionNonce": 1262696779,
      "index": "bFJV",
      "isDeleted": false,
      "groupIds": [
        "EQW5chYPou2XwthEozLq8"
