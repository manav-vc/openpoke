# OpenPoke Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenRouter API key for LLM access
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override the model used by chat, execution, and background agents
# OPENPOKE_MODEL=anthropic/claude-sonnet-5.5

# Required: Composio API key and Gmail auth config ID
# Get these from https://composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here

# Optional: Server configuration
# OPENPOKE_HOST=0.0.0.0
# OPENPOKE_PORT=8001

# Optional: CORS configuration
# OPENPOKE_CORS_ALLOW_ORIGINS=*

# Optional: Documentation
# OPENPOKE_ENABLE_DOCS=1
# OPENPOKE_DOCS_URL=/docs

# Agent registry optimization (one backend process; no separate vector service)
# OPENPOKE_AGENT_REGISTRY_PATH=server/data/agents/registry.db
OPENPOKE_AGENT_HYBRID_SEARCH=1
OPENPOKE_AGENT_COMPACTION=1
OPENPOKE_AGENT_AUTO_ARCHIVE=1
OPENPOKE_AGENT_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENPOKE_AGENT_EMBEDDING_DIMENSIONS=1536
OPENPOKE_AGENT_EMBEDDING_TIMEOUT_SECONDS=5
OPENPOKE_AGENT_ARCHIVE_DAYS=30
OPENPOKE_AGENT_MAX_CONCURRENCY=4
OPENPOKE_AGENT_QUEUE_CAPACITY=100
OPENPOKE_AGENT_QUEUE_WAIT_SECONDS=300
OPENPOKE_AGENT_EXECUTION_TIMEOUT_SECONDS=300
OPENPOKE_AGENT_SHUTDOWN_SECONDS=30
OPENPOKE_AGENT_CANDIDATE_POOL=30
OPENPOKE_AGENT_CANDIDATE_PAGE_SIZE=10
OPENPOKE_AGENT_CANDIDATE_TOKENS=200
OPENPOKE_AGENT_DISCOVERY_TOKENS=6000
OPENPOKE_AGENT_INSPECTION_TOKENS=1500
OPENPOKE_AGENT_INTERACTION_HISTORY_TOKENS=8000
OPENPOKE_AGENT_HISTORY_TOKENS=8000
OPENPOKE_AGENT_SUMMARY_TOKENS=2000
OPENPOKE_AGENT_EXCERPT_TOKENS=2000
OPENPOKE_AGENT_INTERACTION_ITERATIONS=12
OPENPOKE_AGENT_EXECUTION_ITERATIONS=8
OPENPOKE_AGENT_DISCOVERY_CALLS=6
OPENPOKE_AGENT_MAX_INSPECTIONS=3
OPENPOKE_AGENT_MAX_FOLLOWUP_STAGES=5
OPENPOKE_AGENT_MAX_SUBMISSIONS=20
# OPENPOKE_AGENT_TOKEN_SAFETY_MARGIN=1.15
# OPENPOKE_AGENT_MAINTENANCE_INTERVAL_SECONDS=3600
